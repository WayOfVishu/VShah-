# Copy to .env and fill in. .env is gitignored repo-wide — verify with the
# exit code, not the output:
#   git check-ignore -q Tools/Jira-Sync/.env && echo ignored
# (-v prints the matching rule even when that rule is a negation, so its
# output does not answer "is this ignored?" reliably.)
# Check before putting a real token in here.

# Your Atlassian site. No trailing slash, no /rest/api/3 suffix.
JIRA_SITE=https://your-site.atlassian.net

# The project key issues are created under — the part before the dash in an
# issue key like "HWCK-42".
JIRA_PROJECT_KEY=HWCK

# The Atlassian account email. This is the username half of Basic auth and is
# not secret.
JIRA_EMAIL=you@example.com

# API token from https://id.atlassian.com/manage-profile/security/api-tokens
# Password-equivalent. Never goes in a URL, never gets printed.
JIRA_API_TOKEN=
