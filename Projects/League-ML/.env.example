# Copy this file to `.env` (which is gitignored repo-wide) and fill in your own values.
# Never commit your real API key.

# Register a "Personal" key (not "Production") at https://developer.riotgames.com/
RIOT_API_KEY=RGAPI-your-key-here

# Riot uses two different routing schemes:
#   - "regional" routing (americas/europe/asia/sea) for Match-V5 + Account-V1
#   - "platform" routing (na1/euw1/kr/...) for League-V4
# Pick the ones matching the region you're pulling ranked data from.
RIOT_REGION=americas
RIOT_PLATFORM=na1

# Local SQLite file (created automatically by leagueml/storage/db.py)
DB_PATH=data/processed/league.db

# --- deep learning (both optional) ---
# One seed for splits, initialisation and batch order. Record it in #EVAL-1's log.
LEAGUEML_SEED=0
# auto | cpu | cuda. "auto" uses a GPU when PyTorch can see one.
LEAGUEML_DEVICE=auto
