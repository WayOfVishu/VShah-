node_modules/
.env
.env.*
*.log
.DS_Store

# The application database and its WAL sidecars. jobs.db holds every company
# applied to, every title, date and outcome - personal job-search data that
# does not belong in a public repo. The file stays on disk; this only stops it
# being committed. Back it up outside version control.
jobs.db
jobs.db-wal
jobs.db-shm

# Held by a discovery run while it writes (lib/runLock.js), and the output of
# the daily scheduled runs (scripts/scheduled-run.js).
*.discover.lock
logs/

# Your real resume and every generated draft. Personal data — deliberately
# untracked, carried over from the old Job-Board-Scraping .gitignore.
resume/

# Database backups. Snapshots of a mutable binary do not belong in version
# control: they cannot be diffed or merged, they carry the same personal data
# as jobs.db itself, and at ~26MB each they were the largest thing in the
# repo. The files stay on disk — this only stops them being committed.
jobs.db.bak-*
