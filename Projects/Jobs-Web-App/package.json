{
  "name": "jobs-web-app",
  "version": "2.0.0",
  "description": "Job discovery, resume tailoring, and application tracking in one app over a single jobs.db.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "bootstrap-sources": "node scripts/bootstrap-sources.js",
    "discover": "node discover.js",
    "resolve-boards": "node scripts/resolve-boards.js",
    "schedule": "node scripts/schedule-discovery.js",
    "schedule:status": "node scripts/schedule-discovery.js --status",
    "unschedule": "node scripts/schedule-discovery.js --remove",
    "test": "node --test lib/*.test.js db/migrate.test.js connectors/workday.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "express": "^4.19.2",
    "fast-xml-parser": "^5.11.1",
    "fuse.js": "^7.5.0",
    "marked": "^14.1.4",
    "playwright": "^1.62.1"
  }
}
