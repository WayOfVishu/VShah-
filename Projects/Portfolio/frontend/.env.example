# Where the demo API lives. Baked in at BUILD time, not read at runtime, so
# you must rebuild after changing it.
#
# Leave unset when the API and the site are served from the same origin
# (`run.py --serve-static`). Set it when the site is on a CDN and the Python
# process is elsewhere — and add the site's origin to PORTFOLIO_ORIGINS on the
# backend, or CORS will block the demo.
# VITE_API_BASE=https://api.vihangshah.dev
