# Re-read app/data/*.json on every request instead of caching them.
# Turn this on while you are writing content, off in production.
PORTFOLIO_RELOAD=0

# Extra CORS origins, comma separated. Only needed when the frontend is served
# from a different host than the API — e.g. the site on Cloudflare Pages and
# this process on a VPS. Same-origin deploys need nothing here.
# PORTFOLIO_ORIGINS=https://vihangshah.dev,https://www.vihangshah.dev

# Most hosts inject PORT themselves; run.py reads it.
# PORT=8000
# HOST=0.0.0.0
