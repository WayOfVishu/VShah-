# Copy this file to `.env` (which is gitignored) and fill in your own values.
# Never commit your real API key.

# Get a free key at https://aistudio.google.com/apikey (AI Studio free tier —
# see docs/project-charter.md Section 9 for current rate limits/pricing).
GEMINI_API_KEY=your-key-here

# Which Gemini model to call. Flash-Lite is the cheapest/most-available
# option and is plenty for a structured summarization task (Section 9) —
# don't reach for a Pro model here, it's not available on the free tier
# and would be overkill anyway.
GEMINI_MODEL=gemini-flash-lite-latest

# Where the C++ engine binary lives, relative to the repo root, once built
# (see cpp/README or docs/project-charter.md Section 5 for the build steps).
# python/netdiag/engine_runner.py reads this rather than hardcoding a path.
SYSDIAG_ENGINE_PATH=cpp/build/sysdiag_engine
